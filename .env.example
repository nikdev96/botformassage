# Telegram bot
BOT_TOKEN=your_bot_token_here
ADMIN_CHAT_ID=your_admin_chat_id_here
TZ=Asia/Bangkok

# OpenAI ChatGPT (optional feature)
OPENAI_API_KEY=your_openai_api_key_here
FEATURE_CHATGPT=0

# AI Booking Assistant (optional feature)
FEATURE_AI_BOOKING=0

# Webhook для интеграции с внешними системами (optional)
WEBHOOK_URL=

# Google Sheets интеграция (опционально)
SHEETS_ENABLED=0
SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
SHEETS_SHEET_NAME=bookings
GOOGLE_CREDENTIALS_FILE=google_credentials.json

# Напоминания настройки
REMINDERS_ENABLED=0
REMINDER_LEAD_MIN=120
REMINDER_POLL_INTERVAL_SEC=60

# Dev
RUN_TESTS=0
